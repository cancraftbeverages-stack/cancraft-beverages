# Copy to .env.local for local overrides, or set in your hosting provider's
# environment settings for production. Every variable below is read
# server-side only (none are NEXT_PUBLIC_-prefixed except the one that is
# genuinely safe to ship to the browser) — see the comment on each.

# Required before production launch. Used to build absolute canonical URLs,
# Open Graph/Twitter image URLs, sitemap.xml and robots.txt. Falls back to
# http://localhost:3000 when unset (see lib/site.ts) — deploying without
# setting this will put localhost URLs into production SEO metadata. Safe
# to expose to the browser (it's just the site's own public URL) — this is
# the one variable in this file that is intentionally NEXT_PUBLIC_-prefixed.
NEXT_PUBLIC_SITE_URL=https://your-production-domain-here

# --- Google Analytics 4 (optional) -----------------------------------------
# Public GA4 measurement ID (format G-XXXXXXXXXX), not a secret. When unset or
# malformed, GA is not loaded at all and no request is made. Only page_view,
# form_start and enquiry_submit are sent, with sanitised URLs and no form
# values — see lib/analytics/ga.ts. In the GA4 property, turn OFF enhanced
# measurement "Page changes based on browser history events" and "Form
# interactions". NEXT_PUBLIC_ because the browser needs it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Enquiry persistence (Neon Postgres) ---------------------------------
# Server-only. Connection string from your Neon project (Neon dashboard ->
# Connection Details). Run db/schema.sql against this database once before
# setting this in production. When unset:
#   - in local dev (NODE_ENV != production): falls back to appending
#     submissions to .data/enquiries.jsonl (gitignored, dev convenience only)
#   - in production (NODE_ENV = production): the API route fails safely
#     with the existing enquiry-error UI — it never silently drops
#     submissions or fakes success. See lib/enquiry/store.ts.
DATABASE_URL=

# --- Enquiry notification email (Resend) ---------------------------------
# Server-only. API key from your Resend account (Resend dashboard -> API
# Keys).
EMAIL_API_KEY=

# Server-only. Must be an address on a domain verified with Resend (SPF +
# DKIM DNS records) — see PRODUCTION_READINESS.md for the exact setup.
# Cannot be a plain Gmail address.
EMAIL_FROM_ADDRESS=

# Server-only. Where lead notifications are sent. Defaults to CanCraft's
# verified contact address if unset — see content/company.ts.
ENQUIRY_NOTIFICATION_EMAIL=cancraftbeverages@gmail.com

# All four enquiry-related variables above are optional in the sense that
# the app still runs and the enquiry form still works without them (falling
# back to local-file storage and/or skipping the notification email in
# development) — but DATABASE_URL, EMAIL_API_KEY, and EMAIL_FROM_ADDRESS are
# REQUIRED for production enquiries to be durably stored and notified. See
# PRODUCTION_READINESS.md.
